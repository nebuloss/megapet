{
  "name": "megapet-web",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend for Megapet, a self-hosted network speedtest.",
  "license": "MIT",
  "author": "nebuloss",
  "repository": {
    "type": "git",
    "url": "https://github.com/nebuloss/megapet.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:preview": "vite build --config vite.preview.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
